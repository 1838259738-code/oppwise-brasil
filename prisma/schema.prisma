generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Wettbewerber {
  id           Int    @id @default(autoincrement())
  name         String @unique
  farbe        String @default("#000000")
  materialien  Material[]
  automatische AutomatischerEintrag[]
  fieldIntel   FieldIntel[]
}

model Kategorie {
  id           Int    @id @default(autoincrement())
  name         String @unique
  materialien  Material[]
  automatische AutomatischerEintrag[]
}

model Material {
  id             Int      @id @default(autoincrement())
  titel          String
  beschreibung   String?
  wettbewerberId Int
  kategorieId    Int
  aufnahmeDatum  DateTime
  dateiPfade     String
  createdAt      DateTime @default(now())
  wettbewerber   Wettbewerber @relation(fields: [wettbewerberId], references: [id])
  kategorie      Kategorie    @relation(fields: [kategorieId], references: [id])
}

model AutomatischerEintrag {
  id              Int       @id @default(autoincrement())
  titel           String
  zusammenfassung String?
  url             String?
  quelle          String
  wettbewerberId  Int
  kategorieId     Int?
  veroeffentlicht DateTime?
  erfasstAm       DateTime  @default(now())
  istGelesen      Boolean   @default(false)
  wettbewerber    Wettbewerber @relation(fields: [wettbewerberId], references: [id])
  kategorie       Kategorie?   @relation(fields: [kategorieId], references: [id])
}

model Datenquelle {
  id           Int      @id @default(autoincrement())
  name         String
  typ          String
  urlOderConfig String
  aktiv        Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model MonitoringKeyword {
  id      Int     @id @default(autoincrement())
  keyword String
  aktiv   Boolean @default(true)
}

model FieldIntel {
  id               Int      @id @default(autoincrement())
  titel            String
  wettbewerberId   Int
  stadt            String
  screenType       String
  userProfile      String
  tags             String?
  dateiPfade       String
  notizen          String?
  extractedText    String?
  priceFindings    String?
  strategyTags     String?
  aiSummary        String?
  createdAt        DateTime @default(now())
  wettbewerber     Wettbewerber @relation(fields: [wettbewerberId], references: [id])
}